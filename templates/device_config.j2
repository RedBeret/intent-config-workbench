! -----------------------------------------------------------------------------
! synthetic config generated by intent-config-workbench
! hostname: {{ device.hostname }}
! role: {{ device.role }}
! platform: {{ device.platform }}
! -----------------------------------------------------------------------------
hostname {{ device.hostname }}
serial-number {{ device.serial }}
ip domain-name {{ defaults.domain_name }}
banner motd ^
{{ defaults.banner | trim }}
^
!
interface {{ device.mgmt.interface_name }}
 description management
 ip address {{ device.mgmt.ipv4 }}
 ip default-gateway {{ device.mgmt.gateway }}
 no shutdown
!
{% for dns_server in device.mgmt.dns_servers %}
ip name-server {{ dns_server }}
{% endfor %}
{% for ntp_server in defaults.ntp_servers %}
ntp server {{ ntp_server }}
{% endfor %}
!
{% for user in device.users %}
username {{ user.username }} role {{ user.role }} secret 9 {{ user.secret_token }}
 username {{ user.username }} sshkey {{ user.ssh_key }}
{% endfor %}
!
{% for vlan in device.vlans %}
vlan {{ vlan.id }}
 name {{ vlan.name }}
!
{% endfor %}
{% for interface in device.interfaces %}
interface {{ interface.name }}
 description {{ interface.description }}
{% if interface.mode == "access" %}
 switchport mode access
 switchport access vlan {{ interface.access_vlan }}
{% elif interface.mode == "trunk" %}
 switchport mode trunk
 switchport trunk native vlan {{ interface.native_vlan }}
 switchport trunk allowed vlan {{ interface.allowed_vlans | join(",") }}
{% elif interface.mode == "routed" %}
 no switchport
 ip address {{ interface.ipv4_address }}
{% endif %}
 mtu {{ interface.mtu }}
{% if interface.enabled %}
 no shutdown
{% else %}
 shutdown
{% endif %}
!
{% endfor %}
router-id {{ device.routing.router_id }}
{% for route in device.routing.static_routes %}
ip route {{ route.prefix }} {{ route.next_hop }} name {{ route.description }}
{% endfor %}
!
end
